<UserControl x:Class="Task8_WPF.UI.Views.DefaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Task8_WPF.UI.Views"
             xmlns:vm="clr-namespace:Task8_WPF.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DefaultViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="Aqua">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <local:CoursesTreeView Grid.Column="0" DataContext="{Binding CoursesTreeViewModel}" />
        <TextBlock Grid.Column="1" Text="Welcome to Default Page!" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
