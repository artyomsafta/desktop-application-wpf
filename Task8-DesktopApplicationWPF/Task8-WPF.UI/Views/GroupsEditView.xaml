<UserControl x:Class="Task8_WPF.UI.Views.GroupsEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Task8_WPF.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="Aquamarine">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border BorderBrush="Black" BorderThickness="1" Margin="5" Grid.Column="0">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Groups list" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Background="White" />
                <ListBox Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,5" />
                <StackPanel Grid.Row="2" Orientation="Vertical">
                    <Button Content="Create group" Height="28" Margin="0,0,0,5" />
                    <Button Content="Rename group" Height="28" Margin="0,0,0,5" />
                    <Button Content="Delete group" Height="28" Margin="0,0,0,5" />
                    <Button Content="Update teacher" Height="28" />
                </StackPanel>
            </Grid>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" Margin="5" Grid.Column="1">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Import / export of student's list" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Background="White" />
                <Label Grid.Row="1" Content="Select group for import or export:" HorizontalAlignment="Left" FontSize="16" Background="White" Margin="0,5" />
                <ComboBox Grid.Row="2" d:ItemsSource="{d:SampleData ItemCount=5}" HorizontalAlignment="Left" Height="35" Width="200" Margin="0,5" />
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <Button Content="Import students" Height="28" Margin="0,5,5,5" />
                    <Button Content="Export students" Height="28" Margin="0,5,0,5" />
                </StackPanel>
                <Label Grid.Row="5" Content="Save student's list to document" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Background="White" />
                <Label Grid.Row="6" Content="Select group to make a document:" HorizontalAlignment="Left" FontSize="16" Background="White" Margin="0,5" />
                <ComboBox Grid.Row="7" d:ItemsSource="{d:SampleData ItemCount=5}" HorizontalAlignment="Left" Height="35" Width="200" Margin="0,5" />
                <StackPanel Grid.Row="8" Orientation="Horizontal">
                    <Button Content="Save to docx" Height="28" Margin="0,5,5,5" />
                    <Button Content="Save to pdf" Height="28" Margin="0,5,0,5" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
