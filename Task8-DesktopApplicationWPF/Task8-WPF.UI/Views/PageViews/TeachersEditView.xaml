<UserControl x:Class="Task8_WPF.UI.Views.TeachersEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Task8_WPF.UI.Views"
             xmlns:vm="clr-namespace:Task8_WPF.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TeachersEditViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="LightPink">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border BorderBrush="Black" BorderThickness="1" Margin="5" Grid.Column="0">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Select teacher" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Background="White" />
                <ListBox Grid.Row="1" ItemsSource="{Binding TeachersListViewModel.Teachers}" SelectedItem="{Binding SelectedTeacher, Mode=TwoWay}" Margin="0,5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="DarkGray" BorderThickness="1" Padding="3" Margin="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                                    <TextBlock Text="{Binding Surname}" FontWeight="Bold" FontSize="14" Margin="5,0,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" Margin="5" Grid.Column="1">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Add new teacher" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Background="White" />
                <Grid Grid.Row="1" Margin="0,10,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Name:" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="5,0,5,0" />
                    <TextBox Grid.Column="1" Text="{Binding NewTeacherName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Height="28" Margin="0,0,5,0" />
                    <Label Grid.Column="2" Content="Surname:" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="0,0,5,0" />
                    <TextBox Grid.Column="3" Text="{Binding NewTeacherSurname, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Height="28" Margin="0,0,5,0" />
                    <Button Grid.Column="4" Content="Add teacher" Command="{Binding AddNewTeacherCommand}" Height="28" Margin="0,0,5,0" />
                </Grid>
                <Label Grid.Row="2" Content="Update teacher" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Background="White" />
                <Grid Grid.Row="3" Margin="0,10,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="New name:" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="5,0,5,0" />
                    <TextBox Grid.Column="1" Text="{Binding TeacherNameToUpdate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Height="28" Margin="0,0,5,0" />
                    <Label Grid.Column="2" Content="New surname:" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="0,0,5,0" />
                    <TextBox Grid.Column="3" Text="{Binding TeacherSurnameToUpdate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Height="28" Margin="0,0,5,0" />
                    <Button Grid.Column="4" Content="Update" Command="{Binding UpdateTeacherCommand}" Height="28" Margin="0,0,5,0" />
                </Grid>
                <Label Grid.Row="4" Content="Delete teacher" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Background="White" />
                <Button Grid.Row="5" Content="DELETE" Command="{Binding DeleteTeacherCommand}" HorizontalAlignment="Center" FontWeight="SemiBold" Height="28" Margin="0,10,0,20" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
